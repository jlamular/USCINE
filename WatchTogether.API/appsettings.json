{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=WatchTogetherDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "WatchTogether.API",
    "Audience": "WatchTogether.Client",
    "ExpirationMinutes": 60,
    "StreamTokenExpirationMinutes": 360
  },
  "Storage": {
    "VideosRootPath": "App_Data/videos",
    "MaxVideoSizeMb": 1024
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}